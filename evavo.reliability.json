{
  "schemaVersion": "1.0",
  "repository": "EVAVO-STUDIO/client-chat-platform",
  "defaultBranch": "main",
  "authority": "canonical-client-chat-platform",
  "workload": "cloudflare-worker",
  "requiredVisibility": "public",
  "packageManager": {
    "name": "npm",
    "workspace": "worker",
    "lockfilePolicy": "committed-frozen",
    "install": "npm --prefix worker ci --no-audit --no-fund"
  },
  "runtime": {
    "node": "24.x",
    "wrangler": "4.66.x",
    "cloudflareWorkerName": "client-chat-platform",
    "compatibilityDate": "2026-02-17"
  },
  "prePushValidation": [
    "npm --prefix worker ci --no-audit --no-fund",
    "npm --prefix worker run check"
  ],
  "validation": [
    "npm --prefix worker ci --no-audit --no-fund",
    "npm --prefix worker run check:source-secrets",
    "npm --prefix worker run check:config-secrets",
    "npm --prefix worker run check:security",
    "npm --prefix worker run typecheck",
    "npm --prefix worker run check:bundle"
  ],
  "providerConfirmation": {
    "workflow": ".github/workflows/evavo-mainline-confirmation.yml",
    "githubRunner": "ubuntu-latest",
    "exactMainShaRequired": true,
    "cloudflareDeploymentNotPerformedByConfirmation": true,
    "deploymentRequiresSeparateReviewedCloudflareCredentials": true,
    "bundleEvidencePath": "worker/.wrangler/dry-run"
  },
  "branchPolicy": {
    "mode": "direct-main",
    "exclusiveResource": "repository-main:EVAVO-STUDIO/client-chat-platform",
    "exclusiveLeaseRequired": true,
    "forcePushAllowed": false
  },
  "truthBoundaries": [
    "A Wrangler dry-run proves configuration and bundle generation, not a live Cloudflare deployment.",
    "Workers KV rate limits, counters and lead indexes are best-effort and not transactional.",
    "A source check does not prove a configured production bot, exact browser origin or live Workers AI response.",
    "Production completion requires a separately authorised deployment, health check, browser widget smoke and rollback evidence."
  ],
  "autoRepair": {
    "allowed": true,
    "blockedEffects": [
      "credential-change",
      "cloudflare-resource-create-or-delete",
      "cloudflare-binding-rename",
      "production-kv-mutation",
      "production-deployment",
      "external-communication",
      "privacy-retention-expansion"
    ]
  }
}
