/**
 * Cloudflare Wrangler config (JSONC)
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * ADMIN_TOKEN is a Wrangler secret.
 * ADMIN_ALLOWED_ORIGINS is an optional comma-separated, non-secret variable for
 * hosted admin consoles. Localhost and 127.0.0.1 are accepted for development.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-chat-platform",
  "main": "src/hardened.ts",
  "compatibility_date": "2026-02-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "BOT_CONFIG",
      "id": "6905c89c2d8f4e7d99aa3837fd98f1b5"
    },
    {
      "binding": "KB_CACHE",
      "id": "f4dc6f06fb4f4334a1f574c631d5c834",
      "preview_id": "9cbcf7921ec14f1597fda7ae366e2677"
    }
  ],

  "observability": {
    "enabled": true
  }
}
